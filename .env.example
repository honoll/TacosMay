# Copia este archivo como .env y llena los valores. El .env NO se sube al repo.

# Puerto del servidor
PORT=5000

# URL de la base en Redis Cloud (Database > Connect), con usuario y password:
# redis://default:<password>@<host>:<puerto>
REDIS_URL=

# Cadena larga y aleatoria para firmar los JWT. Para generar una:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Opcional: segundos que vive el carrito sin actividad (por defecto 1800 = 30 min).
# Ponlo en 20 para ver a Redis borrar el carrito en vivo.
CARRITO_TTL_SEGUNDOS=

# Administrador que crea `npm run seed`
ADMIN_NOMBRE=Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
